# Copy to .env on the NAS. No secrets in this file.
# HOST_UID/HOST_GID: the DSM user/group that own appdata/claude-host (id <user>).
# DSM user "docker": uid=1027 gid=100(users)
HOST_UID=1027
HOST_GID=100
# Where appdata lives on the NAS (the same DATA_DIR storage-compose.yml uses).
DATA_DIR=/volume1/docker/appdata
